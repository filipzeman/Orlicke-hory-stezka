<section class="container">
  <div class="offline-guide-status" id="offline-guide-status" data-state="empty">
    <div class="offline-guide-copy">
      <div class="offline-guide-heading">
        <strong>Offline průvodce</strong>
        <span class="offline-guide-badge" id="offline-guide-badge">Není stažen</span>
      </div>
      <span id="offline-guide-message">Stáhněte si průvodce pro používání bez internetu.</span>
      <span class="offline-guide-updated" id="offline-guide-updated">Zatím nebylo staženo</span>
    </div>

    <div class="offline-guide-actions">
      <button class="offline-guide-button primary" id="download-guide-button" type="button">
        Stáhnout průvodce
      </button>
      <button class="offline-guide-button secondary" id="remove-guide-button" type="button">
        Smazat
      </button>
    </div>
  </div>
</section>

<style>
  .offline-guide-status {
    max-width: 1200px;
    margin: 1rem auto 0;
    padding: 16px 18px;
    border: 1px solid var(--color-border, rgba(15, 23, 42, 0.12));
    background: var(--color-surface, #ffffff);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .offline-guide-status[data-state="ready"] {
    border-color: rgba(22, 163, 74, 0.25);
    box-shadow: 0 8px 20px rgba(22, 163, 74, 0.08);
    background: rgba(240, 253, 244, 0.9);
  }

  .offline-guide-status[data-state="error"] {
    border-color: rgba(220, 38, 38, 0.2);
    background: rgba(254, 242, 242, 0.9);
  }

  .offline-guide-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .offline-guide-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .offline-guide-copy strong {
    font-size: 0.95rem;
  }

  .offline-guide-copy span {
    color: var(--color-text-muted, #475569);
    font-size: 0.8rem;
  }

  .offline-guide-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    background: rgba(15, 23, 42, 0.06);
    color: var(--color-text, #0f172a);
  }

  .offline-guide-badge[data-tone="success"] {
    background: rgba(22, 163, 74, 0.12);
    color: #166534;
  }

  .offline-guide-badge[data-tone="error"] {
    background: rgba(220, 38, 38, 0.12);
    color: #991b1b;
  }

  .offline-guide-updated {
    color: rgba(15, 23, 42, 0.65);
    font-size: 0.76rem;
  }

  .offline-guide-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .offline-guide-button {
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0.65rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .offline-guide-button:hover {
    transform: translateY(-1px);
  }

  .offline-guide-button:disabled {
    opacity: 0.6;
    cursor: wait;
    transform: none;
  }

  .offline-guide-button.primary {
    background: var(--color-primary, #0f172a);
    color: white;
  }

  .offline-guide-button.secondary {
    background: transparent;
    border-color: var(--color-border, rgba(15, 23, 42, 0.12));
    color: var(--color-text, #0f172a);
  }

  @media (max-width: 640px) {
    .offline-guide-status {
      flex-direction: column;
      align-items: stretch;
    }

    .offline-guide-actions {
      width: 100%;
      justify-content: stretch;
    }

    .offline-guide-button {
      flex: 1 1 0;
    }
  }
</style>

<script type="module">
  import {
    deleteOfflineGuide,
    downloadOfflineGuide,
    loadOfflineGuide,
    getOfflineGuideStatus,
  } from "/src/lib/offlineGuide.ts";

  const messageEl = document.getElementById("offline-guide-message");
  const badgeEl = document.getElementById("offline-guide-badge");
  const updatedEl = document.getElementById("offline-guide-updated");
  const buttonEl = document.getElementById("download-guide-button");
  const removeButtonEl = document.getElementById("remove-guide-button");
  const statusEl = document.getElementById("offline-guide-status");

  function setMessage(text, tone = "neutral") {
    if (!messageEl) return;
    messageEl.textContent = text;
    messageEl.dataset.tone = tone;
  }

  function formatGuideDate(value) {
    if (!value) return "Zatím nebylo staženo";

    try {
      return new Intl.DateTimeFormat("cs-CZ", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      }).format(new Date(value));
    } catch {
      return "Staženo";
    }
  }

  function setBadge(text, tone = "neutral") {
    if (!badgeEl) return;
    badgeEl.textContent = text;
    badgeEl.dataset.tone = tone;
  }

  function setUpdatedText(text) {
    if (!updatedEl) return;
    updatedEl.textContent = text;
  }

  async function refreshGuideState() {
    if (!buttonEl || !removeButtonEl || !statusEl) return;

    try {
      const guide = await loadOfflineGuide();
      const status = await getOfflineGuideStatus();
      const isReady = status === "ready" && !!guide;
      const isOffline = typeof navigator !== "undefined" && !navigator.onLine;

      buttonEl.disabled = isOffline && !isReady;
      removeButtonEl.disabled = !isReady;

      if (isReady) {
        buttonEl.textContent = isOffline ? "Připojení není k dispozici" : "Aktualizovat průvodce";
        buttonEl.disabled = isOffline;
        statusEl.dataset.state = "ready";
        setBadge("Staženo", "success");
        setMessage(
          isOffline
            ? "Průvodce je stažený a dostupný i bez internetu."
            : "Průvodce je připravený k použití offline.",
          "success",
        );
        setUpdatedText(`Poslední aktualizace: ${formatGuideDate(guide.generatedAt)}`);
      } else if (status === "error") {
        buttonEl.textContent = "Stáhnout průvodce";
        statusEl.dataset.state = "error";
        setBadge("Chyba", "error");
        setMessage("Offline průvodce není dostupný. Zkuste to znovu.", "error");
        setUpdatedText("Při načítání dat došlo k chybě.");
      } else {
        buttonEl.textContent = isOffline ? "Připojení není k dispozici" : "Stáhnout průvodce";
        buttonEl.disabled = isOffline;
        statusEl.dataset.state = "empty";
        setBadge("Není stažen", "neutral");
        setMessage(
          isOffline
            ? "Bez internetu je k dispozici jen stažený průvodce, který zatím není uložen."
            : "Stáhněte si průvodce pro používání bez internetu.",
          "neutral",
        );
        setUpdatedText("Zatím nebylo staženo");
      }
    } catch (error) {
      console.error("Offline guide status failed", error);
      statusEl.dataset.state = "error";
      setBadge("Chyba", "error");
      setMessage("Offline průvodce není dostupný. Zkuste to znovu.", "error");
      setUpdatedText("Při načítání dat došlo k chybě.");
      buttonEl.disabled = false;
      removeButtonEl.disabled = true;
    }
  }

  async function handleDownload() {
    if (!buttonEl || !statusEl) return;

    buttonEl.disabled = true;
    statusEl.dataset.state = "empty";
    setBadge("Stahuje se", "neutral");
    setMessage("Stahování průvodce…", "neutral");
    setUpdatedText("Aktualizace probíhá");

    try {
      const guide = await downloadOfflineGuide();
      buttonEl.textContent = "Aktualizovat průvodce";
      statusEl.dataset.state = "ready";
      setBadge("Staženo", "success");
      setMessage("Průvodce je připravený k použití offline.", "success");
      setUpdatedText(`Poslední aktualizace: ${formatGuideDate(guide.generatedAt)}`);
    } catch (error) {
      console.error("Guide download failed", error);
      statusEl.dataset.state = "error";
      setBadge("Chyba", "error");
      setMessage("Stahování selhalo. Zkuste to prosím znovu.", "error");
      setUpdatedText("Stahování se nepodařilo");
    } finally {
      buttonEl.disabled = false;
      await refreshGuideState();
    }
  }

  async function handleRemove() {
    if (!removeButtonEl || !statusEl) return;

    removeButtonEl.disabled = true;
    setBadge("Mazání", "neutral");
    setMessage("Mazání průvodce…", "neutral");
    setUpdatedText("Odstraňování dat probíhá");

    try {
      await deleteOfflineGuide();
      buttonEl.textContent = "Stáhnout průvodce";
      statusEl.dataset.state = "empty";
      setBadge("Není stažen", "neutral");
      setMessage("Průvodce byl smazán. Přístup k datům je jen online.", "neutral");
      setUpdatedText("Zatím nebylo staženo");
    } catch (error) {
      console.error("Guide removal failed", error);
      statusEl.dataset.state = "error";
      setBadge("Chyba", "error");
      setMessage("Smazání selhalo. Zkuste to prosím znovu.", "error");
      setUpdatedText("Smazání se nepodařilo");
    } finally {
      removeButtonEl.disabled = false;
      await refreshGuideState();
    }
  }

  if (buttonEl) {
    buttonEl.addEventListener("click", (event) => {
      event.preventDefault();
      void handleDownload();
    });
  }

  if (removeButtonEl) {
    removeButtonEl.addEventListener("click", (event) => {
      event.preventDefault();
      void handleRemove();
    });
  }

  const initializeOfflineGuideStatus = () => {
    void refreshGuideState();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeOfflineGuideStatus, { once: true });
  } else {
    initializeOfflineGuideStatus();
  }

  window.addEventListener("online", () => {
    void refreshGuideState();
  });
  window.addEventListener("offline", () => {
    void refreshGuideState();
  });
</script>
