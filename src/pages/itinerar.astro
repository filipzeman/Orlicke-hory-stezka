---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSupabase } from "../lib/supabase.ts";
import PointCard from "../components/PointCard.astro";

import { groupPointsByLocation } from "../utils/groupPoints";
import type { Point } from "../types/point";
import Icon from "../components/Icon.astro";

const supabase = getSupabase();
let { data } = await supabase.from("points").select("*").order("km", { ascending: true });
const { data: detailsData } = await supabase.from("point_details").select("*");

const safeData = Array.isArray(data) ? data : [];
const safeDetailsData = Array.isArray(detailsData) ? detailsData : [];

const detailsMap = new Map(
  safeDetailsData.map((detail) => [detail.point_id, detail]),
);

let points = safeData.map((point) => ({
  ...point,
  details: detailsMap.get(point.id) ?? null,
})) as Point[];

if (!points.length) {
  console.error("Nenalezena žádná data o bodech.");
} else {
  console.log(`Načteno ${points.length} bodů z databáze.`);
}

const sortedPoints = [...points].sort((a, b) => a.km - b.km);

const groupedPoints = groupPointsByLocation(sortedPoints);
groupedPoints.sort((a, b) => a.km - b.km);

const filter = Astro.url.searchParams.get("filtr");
const showGroupedPoints = !filter || filter === "vse";

const filteredPoints = sortedPoints.filter((point) => {
  if (!filter || filter === "vse") return true;
  return point.category === filter;
});

const pointsToRender = showGroupedPoints ? groupedPoints : filteredPoints;

const filters = [
  { key: "vse", label: "Vše", icon: "LayoutGrid" },
  { key: "ubytovani", label: "Ubytování", icon: "Bed" },
  { key: "obcerstveni", label: "Občerstvení", icon: "Utensils" },
  { key: "navigace", label: "Navigace", icon: "Signpost" },
  { key: "doprava", label: "Doprava", icon: "BusFront" },
  { key: "turisticke_cile", label: "Cíle", icon: "MapPin" },
  { key: "ostatni", label: "Ostatní", icon: "Info" },
];
---

<BaseLayout title="Itinerář | Orlické hory">
  <section class="container intro-compact">
    <div class="intro-text">
      <h1>Itinerář</h1>
      <p>Přehled bodů podél trasy.</p>
    </div>

    <div class="geo-row">
      <button id="location-btn" class="btn btn-primary"> Moje poloha</button>

      <span id="locate-status" class="geo-status"></span>
    </div>
  </section>

  <!-- FILTER BAR (ONLY STICKY ELEMENT) -->
  <section class="filter-bar">
    <div class="filter-bar-inner container">
      {
        filters.map((f) => (
          <a
            href={`/itinerar?filtr=${f.key}`}
            class={`filter-icon ${(filter ?? "vse") === f.key ? "active" : ""}`}
            aria-label={f.label}
          >
            <Icon name={f.icon} size={18} />
          </a>
        ))
      }
   </div>
    
  </section>

  <!-- CONTENT -->
  <section class="container points">
    {pointsToRender.length === 0 && (
      <p class="text-center text-muted">Bohužel nejsou k dispozici žádná data (technická chyba), prosím dejte nám o tom vědět pomocí kontaktního formuláře, moc děkujeme.</p>
    )}
    {
      pointsToRender.map((point, index) => (
        <PointCard filter={filter} point={point} last={index === pointsToRender.length - 1} />
      ))
    }
  </section>
</BaseLayout>
<script>
  import {
    getOfflineGuideRuntimeState,
    loadOfflineGuide,
    normalizeGuideSlug,
  } from "../lib/offlineGuide.ts";
  import { getPointSlug } from "../utils/getPointsSlug.ts";

  const offlineContainer = document.querySelector(".points");

  async function renderOfflineItinerary() {
    if (!offlineContainer) return;

    const state = await getOfflineGuideRuntimeState();
    const guide = state.guide;
    if (!guide || !state.shouldUseOfflineFallback) return;

    const params = new URLSearchParams(window.location.search);
    const selectedFilter = params.get("filtr") || "vse";
    const filteredPoints = (guide.points ?? []).filter((point) => {
      if (!point) return false;
      return selectedFilter === "vse" ? true : point.category === selectedFilter;
    });

    if (!filteredPoints.length) {
      offlineContainer.innerHTML =
        '<p class="text-center text-muted">Offline průvodce neobsahuje žádné body pro tento filtr.</p>';
      return;
    }

    const groupedByLocation = new Map();

    for (const point of filteredPoints) {
      const key = point.location_id || point.location_name || point.point_name || `${point.km ?? "-"}-${point.id}`;
      const existing = groupedByLocation.get(key);

      if (existing) {
        existing.km = existing.km ?? point.km;
        existing.points.push(point);
        continue;
      }

      groupedByLocation.set(key, {
        locationName: point.location_name || point.point_name || "Bod trasy",
        km: point.km,
        points: [point],
      });
    }

    const groupedItems = [...groupedByLocation.values()].sort((a, b) => (a.km ?? 0) - (b.km ?? 0));
    const categoryLabels = {
      ubytovani: "Ubytování",
      obcerstveni: "Občerstvení",
      navigace: "Navigace",
      doprava: "Doprava",
      turisticke_cile: "Turistické cíle",
      ostatni: "Ostatní",
    };

    const links = groupedItems
      .map((group) => {
        const representative = group.points?.[0];
        if (!representative) return "";

        const slug = getPointSlug(representative);
        const displayName = representative.location_name || representative.point_name || "Bod trasy";
        const km = representative.km ? `${representative.km} km` : "Bez km";
        const href = `/bod/${normalizeGuideSlug(slug)}`;
        const categories = [...new Set(group.points.map((point: any) => point.category).filter(Boolean))] as string[];
        const badges = categories
          .slice(0, 3)
          .map((category: string) => `<span class="offline-guide-pill">${categoryLabels[category as keyof typeof categoryLabels] || category}</span>`)
          .join("");

        return `
          <div class="offline-guide-item">
            <a href="${href}" class="offline-guide-link">
              <div class="offline-guide-main">
                <span class="offline-guide-name">${displayName}</span>
                <div class="offline-guide-badges">${badges}</div>
              </div>
              <span class="offline-guide-meta">${km}</span>
            </a>
          </div>
        `;
      })
      .join("");

    offlineContainer.innerHTML = `
      <div class="offline-guide-header">
        <h2>Stáhnutý průvodce</h2>
        <span>Bez internetu</span>
      </div>
      <div class="offline-guide-list">${links}</div>
    `;
  }

  const shouldUseOfflineFallback = async () => {
    const state = await getOfflineGuideRuntimeState();
    return state.shouldUseOfflineFallback && state.pwaInstalled;
  };

  const initOfflineFallback = async () => {
    if (await shouldUseOfflineFallback()) {
      await renderOfflineItinerary();
    }
  };

  window.addEventListener("DOMContentLoaded", initOfflineFallback);
  document.addEventListener("astro:after-swap", initOfflineFallback);
  document.addEventListener("astro:page-load", initOfflineFallback);
  window.addEventListener("online", async () => {
    if (!(await shouldUseOfflineFallback())) {
      window.location.reload();
    }
  });
  window.addEventListener("offline", initOfflineFallback);

  // The service worker caches "/itinerar" ignoring the query string, so a full
  // page navigation to a different filter can serve back a stale/mismatched
  // cached page offline. Intercept filter clicks and re-render client-side
  // instead, so filtering always works regardless of what the cache returns.
  const filterLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".filter-icon"));

  function setActiveFilterLink(filterKey: string) {
    filterLinks.forEach((link) => {
      const linkUrl = new URL(link.href, window.location.origin);
      const linkFilter = linkUrl.searchParams.get("filtr") || "vse";
      link.classList.toggle("active", linkFilter === filterKey);
    });
  }

  filterLinks.forEach((link) => {
    link.addEventListener("click", async (event) => {
      if (!(await shouldUseOfflineFallback())) return;

      event.preventDefault();
      const linkUrl = new URL(link.href, window.location.origin);
      const filterKey = linkUrl.searchParams.get("filtr") || "vse";

      window.history.pushState({}, "", linkUrl.toString());
      setActiveFilterLink(filterKey);
      await renderOfflineItinerary();
    });
  });

  window.addEventListener("popstate", async () => {
    if (!(await shouldUseOfflineFallback())) return;

    const params = new URLSearchParams(window.location.search);
    setActiveFilterLink(params.get("filtr") || "vse");
    await renderOfflineItinerary();
  });

  const offlineStyles = `
    .offline-guide-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin: 0 0 1rem;
      padding: 0.45rem 0;
      border-bottom: 1px solid rgba(15, 23, 42, 0.1);
    }

    .offline-guide-header h2 {
      margin: 0;
      font-size: clamp(1.4rem, 2vw, 2rem);
    }

    .offline-guide-header span {
      color: rgba(15, 23, 42, 0.62);
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .offline-guide-list {
      display: grid;
      gap: 0.75rem;
    }

    .offline-guide-item {
      border: 1px solid rgba(15, 23, 42, 0.1);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.7);
      overflow: hidden;
      transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    .offline-guide-item:hover {
      transform: translateY(-1px);
      border-color: rgba(15, 23, 42, 0.18);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
    }

    .offline-guide-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.1rem;
      text-decoration: none;
      color: inherit;
      font-weight: 600;
    }

    .offline-guide-main {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      min-width: 0;
    }

    .offline-guide-name {
      color: var(--color-text, #0f172a);
      font-size: 1rem;
      line-height: 1.35;
    }

    .offline-guide-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .offline-guide-pill {
      display: inline-flex;
      align-items: center;
      padding: 0.2rem 0.45rem;
      border-radius: 999px;
      background: rgba(15, 23, 42, 0.06);
      color: rgba(15, 23, 42, 0.74);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .offline-guide-meta {
      font-size: 0.8rem;
      color: rgba(15, 23, 42, 0.68);
      white-space: nowrap;
    }
  `;

  const styleTag = document.createElement("style");
  styleTag.textContent = offlineStyles;
  document.head.appendChild(styleTag);

  const initLocationButton = () => {
    const locationBtn = document.getElementById("location-btn");
    const status = document.getElementById("locate-status");
    const filterBar = document.querySelector(".filter-bar");

    if (!locationBtn) {
      return;
    }

    let locationActive = false;
    let currentElement: HTMLElement | null = null;

    const handleSticky = () => {
      if (!filterBar) return;

      const rect = filterBar.getBoundingClientRect();
      if (rect.top <= 65) {
        filterBar.classList.add("is-sticky");
      } else {
        filterBar.classList.remove("is-sticky");
      }
    };

    window.addEventListener("scroll", handleSticky, { passive: true });
    handleSticky();

    function toRad(value: number): number {
      return (value * Math.PI) / 180;
    }

    function distance(a: { lat: number; lng: number }, b: { lat: number; lng: number }): number {
      const earthRadius = 6371;
      const dLat = toRad(b.lat - a.lat);
      const dLng = toRad(b.lng - a.lng);
      const lat1 = toRad(a.lat);
      const lat2 = toRad(b.lat);
      const aValue =
        Math.sin(dLat / 2) ** 2 + Math.sin(dLng / 2) ** 2 * Math.cos(lat1) * Math.cos(lat2);
      const c = 2 * Math.atan2(Math.sqrt(aValue), Math.sqrt(1 - aValue));
      return earthRadius * c;
    }

    function highlightNearest(user: { lat: number; lng: number }): HTMLElement | null {
      const items = Array.from(document.querySelectorAll(".item")) as HTMLElement[];
      let closest: HTMLElement | null = null;
      let minDist = Infinity;

      for (const el of items) {
        const lat = Number((el as HTMLElement).dataset.lat);
        const lng = Number((el as HTMLElement).dataset.lng);

        if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
          continue;
        }

        const currentDistance = distance(user, { lat, lng });
        if (currentDistance < minDist) {
          minDist = currentDistance;
          closest = el;
        }
      }

      if (!closest) {
        return null;
      }

      document.querySelectorAll(".item.active").forEach((item) => item.classList.remove("active"));
      closest.classList.add("active");
      return closest;
    }

    function getStickyOffset(): number {
      const stickyNav = document.querySelector(".sticky-nav") as HTMLElement | null;
      return stickyNav ? stickyNav.offsetHeight : 0;
    }

    function scrollToElement(el: HTMLElement): void {
      const offset = getStickyOffset();
      const y = el.getBoundingClientRect().top + window.pageYOffset - offset - 150;
      window.scrollTo({ top: y, behavior: "smooth" });
    }

    const stored = sessionStorage.getItem("user-location");
    if (stored) {
      try {
        const user = JSON.parse(stored);
        const el = highlightNearest(user);

        if (el) {
          currentElement = el;
          locationActive = true;
          locationBtn.textContent = "Poloha aktivní";
        }
      } catch (error) {
        console.warn("Invalid cached user location", error);
        sessionStorage.removeItem("user-location");
      }
    }

    locationBtn.addEventListener("click", () => {
      if (locationActive && currentElement) {
        scrollToElement(currentElement);
        return;
      }

      if (!navigator.geolocation) {
        if (status) status.textContent = "Geolokace není podporována";
        return;
      }

      if (status) status.textContent = "Získávám polohu…";

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const user = {
            lat: pos.coords.latitude,
            lng: pos.coords.longitude,
          };

          sessionStorage.setItem("user-location", JSON.stringify(user));

          const el = highlightNearest(user);
          if (el) {
            currentElement = el;
            scrollToElement(el);
          }

          locationActive = true;
          locationBtn.textContent = "📍 Poloha aktivní";
          if (status) status.textContent = "";
        },
        (error) => {
          console.warn("Geolocation failed", error);
          if (status) status.textContent = "Poloha zamítnuta";
        },
        {
          enableHighAccuracy: true,
          timeout: 12000,
          maximumAge: 0,
        },
      );
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLocationButton, { once: true });
  } else {
    initLocationButton();
  }
</script>

<style>

  .intro-compact {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.intro-text h1 {
  margin-bottom: 1rem;
  font-size: 1.2rem;
}

.intro-text p {
  font-size: 0.85rem;
  color: var(--color-text);
}

.geo-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.geo-status {
  font-size: 0.8rem;
  color: var(--color-text-muted);
}

.filter-bar {
  position: sticky;
  top: var(--header-height);
  z-index: 30;
  display: flex;
  gap: 10px;
  overflow-x: auto;
  background: var(--color-bg); /* default */
  transition: background 0.2s ease, border-color 0.2s ease;
  height: var(--header-height);
  @media (min-width: 768px) {
    top: var(--header-height);
  }
}

/* sticky state */
.filter-bar.is-sticky {
  background: var(--color-surface);
  box-shadow: 0 2px 6px rgba(0,0,0,0.06);
}

.filter-bar::-webkit-scrollbar {
    display: none;
}

.filter-bar-inner {
  display: flex;
  max-width: var(--max-width);
  margin: 0 auto;
  gap:0.8rem;
  width:100%;
  padding: 12px 16px;
}

  /* ICON BUTTON */
  .filter-icon {
    flex: 0 0 auto;

    width: 36px;
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background: var(--color-surface);
    border: 1px solid var(--color-border);

    color: var(--color-text);
  }

  /* ACTIVE */
  .filter-icon.active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);

    svg {
      color: var(--color-surface);
    }
  }

  /* TOUCH */
  .filter-icon:active {
    transform: scale(0.95);
  }

  /* SNAP (nice UX) */
  .filter-bar {
    scroll-snap-type: x mandatory;
  }

  .filter-icon {
    scroll-snap-align: start;
  }

  /* POINTS */
  .points {
    display: flex;
    flex-direction: column;
    padding-left: 20px;
  }

  :global(.item.active) {
    background: rgba(47, 133, 90, 0.05);
    border-radius: 10px;
  }

  :global(.item.active::before) {
    width: 14px;

    height: 14px;

    background: var(--color-accent);

    border: 3px solid white;

    box-shadow: 0 0 0 3px var(--color-accent);

    transform: scale(1.1);
    top: 0.6rem;
    left: -5px;

    transition: all 0.2s ease;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(47, 133, 90, 0.4);
    }

    70% {
      box-shadow: 0 0 0 6px rgba(47, 133, 90, 0);
    }

    100% {
      box-shadow: 0 0 0 0 rgba(47, 133, 90, 0);
    }
  }

  /* BUTTON STATE */
  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;

  /* desktop */
  @media (min-width: 768px) {
    .filter-bar {
      justify-content: center;
      mask-image: none;
    }
  }
</style>
