---
import { getSupabase } from "../../lib/supabase";
import { marked } from "marked";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DetailHeader from "../../components/detail/DetailHeader.astro";
import DetailSection from "../../components/detail/DetailSection.astro";
import ServiceCard from "../../components/detail/ServiceCard.astro";
import DetailGallery from "../../components/detail/DetailGallery.astro";

const supabase = getSupabase();

const IMAGES_BUCKET = "images";

function toPublicImageUrl(image: unknown): string | null {
  let path: string | null = null;

  if (typeof image === "string") {
    path = image;
  } else if (image && typeof image === "object") {
    const value = image as { path?: unknown; url?: unknown; publicUrl?: unknown };

    if (typeof value.publicUrl === "string") {
      return value.publicUrl;
    }

    if (typeof value.url === "string") {
      path = value.url;
    } else if (typeof value.path === "string") {
      path = value.path;
    }
  }

  if (!path) {
    return null;
  }

  if (/^https?:\/\//i.test(path)) {
    return path;
  }

  const {
    data: { publicUrl },
  } = supabase.storage.from(IMAGES_BUCKET).getPublicUrl(path.replace(/^\/+/, ""));

  return publicUrl;
}

// 1. get slug from URL
const { slug } = Astro.params;

// 2. fetch ALL points (simple & fast enough)
const { data } = await supabase.from("points").select("*");

const points = data ?? [];

const normalize = (v: string | undefined) => v?.toLowerCase().replace(/_/g, "-");

const pointIdMatch = slug?.match(/^(\d+)/);

let locationPoints = [];

if (pointIdMatch) {
  // standalone point

  const pointId = `pt_${pointIdMatch[1]}`;

  const point = points.find((p) => p.id === pointId);

  locationPoints = point ? [point] : [];
} else {
  // grouped location

  locationPoints = points.filter(
    (p) => p.location_id && normalize(p.location_id) === normalize(slug)
  );
}

// console.log(
//   locationPoints.map((p) => ({
//     id: p.id,

//     point_name: p.point_name,

//     location_id: p.location_id,
//   }))
// );

// 5. Fetch details for all points at this location
const pointIds = locationPoints.map((p) => p.id);

const { data: detailsData, error: detailsError } = await supabase
  .from("point_details")
  .select("*")
  .in("point_id", pointIds);

if (detailsError) {
  console.error("Failed to fetch point details:", detailsError);
}

// Create quick lookup by point ID
const detailsByPointId = new Map((detailsData ?? []).map((details) => [details.point_id, details]));

// Combine points with their details
locationPoints = locationPoints.map((point) => {
  const details = detailsByPointId.get(point.id);

  return {
    ...point,

    phone: details?.phone ?? null,
    email: details?.email ?? null,
    website: details?.website ?? null,
    opening_info: details?.opening_info ?? null,
    note: details?.note ?? null,
    hikers_welcome: details?.hikers_welcome ?? false,

    images: details?.images ?? [],
  };
});

// Collect public image URLs
const imageUrls = locationPoints.flatMap((point) =>
  (point.images ?? [])
    .map((image) => toPublicImageUrl(image))
    .filter((url): url is string => Boolean(url))
);

console.log("Loaded point details:", detailsData?.length ?? 0);
console.log("Image URLs:", imageUrls.length);

// 5. get location info
const location = locationPoints[0] ?? null;

// 6. group by category

const grouped: Record<string, typeof locationPoints> = {
  ubytovani: locationPoints.filter((p) => p.category === "ubytovani"),
  obcerstveni: locationPoints.filter((p) => p.category === "obcerstveni"),
  doprava: locationPoints.filter((p) => p.category === "doprava"),
  navigace: locationPoints.filter((p) => p.category === "navigace"),
  turisticke_cile: locationPoints.filter((p) => p.category === "turisticke_cile"),
  ostatni: locationPoints.filter((p) => p.category === "ostatni"),
};
// 7. order of sections
const sections = [
  { key: "ubytovani", title: "Ubytování" },
  { key: "obcerstveni", title: "Občerstvení" },
  { key: "navigace", title: "Navigace" },
  { key: "doprava", title: "Doprava" },
  { key: "turisticke_cile", title: "Turistické cíle" },
  { key: "ostatni", title: "Ostatní" },
];
---

<BaseLayout title={`${location?.location_name || location?.point_name} | Orlické hory`}>
  <main class="container">
    {
      location && (
        <>
          <DetailHeader location={location} services={locationPoints} />
          <DetailGallery images={imageUrls} />

          {sections.map(
            (section) =>
              grouped[section.key]?.length > 0 && (
                <DetailSection title={section.title}>
                  {grouped[section.key].map((service) => (
                    <ServiceCard service={service} point={location} />
                  ))}
                </DetailSection>
              )
          )}
        </>
      )
    }
  </main>
</BaseLayout>
