---
import { getSupabase } from "../../lib/supabase";
import { marked } from "marked";
import { slugify } from "../../utils/slugify";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DetailHeader from "../../components/detail/DetailHeader.astro";
import DetailSection from "../../components/detail/DetailSection.astro";
import ServiceCard from "../../components/detail/ServiceCard.astro";
import DetailGallery from "../../components/detail/DetailGallery.astro";

const supabase = getSupabase();

const IMAGES_BUCKET = "images";

const safeArray = <T,>(value: T[] | null | undefined): T[] => (Array.isArray(value) ? value : []);

function toPublicImageUrl(image: unknown): string | null {
  let path: string | null = null;

  if (typeof image === "string") {
    path = image;
  } else if (image && typeof image === "object") {
    const value = image as { path?: unknown; url?: unknown; publicUrl?: unknown };

    if (typeof value.publicUrl === "string") {
      return value.publicUrl;
    }

    if (typeof value.url === "string") {
      path = value.url;
    } else if (typeof value.path === "string") {
      path = value.path;
    }
  }

  if (!path) {
    return null;
  }

  if (/^https?:\/\//i.test(path)) {
    return path;
  }

  const {
    data: { publicUrl },
  } = supabase.storage.from(IMAGES_BUCKET).getPublicUrl(path.replace(/^\/+/, ""));

  return publicUrl;
}

// 1. get slug from URL
const { slug } = Astro.params;

// 2. fetch ALL points (simple & fast enough)
const { data } = await supabase.from("points").select("*");

const points = safeArray(data as Array<any>);

const normalize = (v: string | undefined) => slugify(v ?? "");

const pointIdMatch = slug?.match(/^(\d+)/);

let locationPoints = [];

if (pointIdMatch) {
  // standalone point

  const pointId = `pt_${pointIdMatch[1]}`;

  const point = points.find((p) => p.id === pointId);

  locationPoints = point ? [point] : [];
} else {
  // grouped location

  locationPoints = points.filter(
    (p) => p.location_id && normalize(p.location_id) === normalize(slug)
  );
}

// console.log(
//   locationPoints.map((p) => ({
//     id: p.id,

//     point_name: p.point_name,

//     location_id: p.location_id,
//   }))
// );

// 5. Fetch details for all points at this location
const pointIds = locationPoints.map((p) => p.id);

const { data: detailsData, error: detailsError } = await supabase
  .from("point_details")
  .select("*")
  .in("point_id", pointIds);

if (detailsError) {
  console.error("Failed to fetch point details:", detailsError);
}

// Create quick lookup by point ID
const detailsByPointId = new Map((detailsData ?? []).map((details) => [details.point_id, details]));

// Combine points with their details
locationPoints = locationPoints.map((point) => {
  const details = detailsByPointId.get(point.id);

  return {
    ...point,

    phone: details?.phone ?? null,
    email: details?.email ?? null,
    website: details?.website ?? null,
    opening_info: details?.opening_info ?? null,
    note: details?.note ?? null,
    hikers_welcome: details?.hikers_welcome ?? false,

    images: details?.images ?? [],
  };
});

// Collect public image URLs
const imageUrls = locationPoints.flatMap((point) =>
  (point.images ?? [])
    .map((image) => toPublicImageUrl(image))
    .filter((url): url is string => Boolean(url))
);

console.log("Loaded point details:", detailsData?.length ?? 0);
console.log("Image URLs:", imageUrls.length);

// 5. get location info
const location = locationPoints[0] ?? null;

// 6. group by category

const grouped: Record<string, typeof locationPoints> = {
  ubytovani: locationPoints.filter((p) => p.category === "ubytovani"),
  obcerstveni: locationPoints.filter((p) => p.category === "obcerstveni"),
  doprava: locationPoints.filter((p) => p.category === "doprava"),
  navigace: locationPoints.filter((p) => p.category === "navigace"),
  turisticke_cile: locationPoints.filter((p) => p.category === "turisticke_cile"),
  ostatni: locationPoints.filter((p) => p.category === "ostatni"),
};
// 7. order of sections
const sections = [
  { key: "ubytovani", title: "Ubytování" },
  { key: "obcerstveni", title: "Občerstvení" },
  { key: "navigace", title: "Navigace" },
  { key: "doprava", title: "Doprava" },
  { key: "turisticke_cile", title: "Turistické cíle" },
  { key: "ostatni", title: "Ostatní" },
];
---

<BaseLayout title={`${location?.location_name || location?.point_name} | Orlické hory`}>
  <main class="container">
    {
      location && (
        <>
          <DetailHeader location={location} services={locationPoints} />
          <DetailGallery images={imageUrls} />

          {sections.map(
            (section) =>
              grouped[section.key]?.length > 0 && (
                <DetailSection title={section.title}>
                  {grouped[section.key].map((service) => (
                    <ServiceCard service={service} point={location} />
                  ))}
                </DetailSection>
              )
          )}
        </>
      )
    }
  </main>
</BaseLayout>
<script>
  import {
    getOfflineGuideRuntimeState,
    getGuideRoutePoints,
    normalizeGuideSlug,
  } from "../../lib/offlineGuide.ts";

  function renderOfflineDetail() {
    const slug = normalizeGuideSlug(window.location.pathname.replace(/^\/bod\//, ""));
    const main = document.querySelector("main.container");

    if (!main) return;

    getOfflineGuideRuntimeState().then((state) => {
      const guide = state.guide;
      if (!guide || !slug || !state.shouldUseOfflineFallback) {
        main.innerHTML = `
          <section class="offline-empty-state">
            <div class="offline-empty-card">
              <p class="eyebrow">Offline průvodce</p>
              <h1>Stáhnutý obsah není k dispozici</h1>
              <p>Nejdříve si stáhněte průvodce pro tuto aplikaci, aby se zde zobrazily informace i bez internetu.</p>
              <a href="/" class="back-link">Zpět na úvod</a>
            </div>
          </section>
        `;
        return;
      }

      const points = getGuideRoutePoints(guide, slug);
      if (!points.length) {
        main.innerHTML = `
          <section class="offline-empty-state">
            <div class="offline-empty-card">
              <p class="eyebrow">Offline průvodce</p>
              <h1>Detail neexistuje v stažené verzi</h1>
              <p>Pro tento bod není k dispozici offline data. Zkuste otevřít stránku online nebo stáhnout nový průvodce.</p>
              <a href="/itinerar" class="back-link">Zobrazit itinerář</a>
            </div>
          </section>
        `;
        return;
      }

      const location = points[0];
      const title = location.location_name || location.point_name;
      const km = location.km ?? "";
      const grouped = {
        ubytovani: points.filter((p) => p.category === "ubytovani"),
        obcerstveni: points.filter((p) => p.category === "obcerstveni"),
        doprava: points.filter((p) => p.category === "doprava"),
        navigace: points.filter((p) => p.category === "navigace"),
        turisticke_cile: points.filter((p) => p.category === "turisticke_cile"),
        ostatni: points.filter((p) => p.category === "ostatni"),
      };

      const sections = [
        { key: "ubytovani", title: "Ubytování" },
        { key: "obcerstveni", title: "Občerstvení" },
        { key: "navigace", title: "Navigace" },
        { key: "doprava", title: "Doprava" },
        { key: "turisticke_cile", title: "Turistické cíle" },
        { key: "ostatni", title: "Ostatní" },
      ];

      const sectionMarkup = sections
        .filter((section) => grouped[section.key]?.length)
        .map((section) => {
          const cards = grouped[section.key]
            .map((service) => {
              const notes =
                (service.note ?? "")
                  .split("-")
                  .map((entry) => entry.replace(/^-\s?/, "").trim())
                  .filter(Boolean) ?? [];

              const contactItems = [
                service.phone
                  ? `<a class="service-info" href="tel:${service.phone}"><span>${service.phone}</span></a>`
                  : "",
                service.website
                  ? `<a class="service-info" href="${service.website}" target="_blank" rel="noreferrer"><span>${service.website}</span></a>`
                  : "",
                service.opening_info
                  ? `<div class="service-info"><span>${service.opening_info}</span></div>`
                  : "",
              ]
                .filter(Boolean)
                .join("");

              const notesMarkup = notes.length
                ? `<ul class="notes">${notes.map((note) => `<li>${note}</li>`).join("")}</ul>`
                : "";

              return `
                <div class="card">
                  <div class="title">${service.point_name}</div>
                  <div class="info">${contactItems}</div>
                  ${notesMarkup}
                </div>
              `;
            })
            .join("");

          return `
            <section class="section">
              <h2>${section.title}</h2>
              <div class="content">${cards}</div>
            </section>
          `;
        })
        .join("");

      const summary = [
        grouped.ubytovani.length ? "Ubytování" : "",
        grouped.obcerstveni.length ? "Občerstvení" : "",
        grouped.doprava.length ? "Doprava" : "",
        grouped.navigace.length ? "Navigace" : "",
        grouped.turisticke_cile.length ? "Turistické cíle" : "",
        grouped.ostatni.length ? "Ostatní" : "",
      ]
        .filter(Boolean)
        .join(" · ");

      main.innerHTML = `
        <header class="header">
          <div class="location-info">
            <h1>${title} <span> | ${km} km</span></h1>
          </div>
          <div class="summary">${summary || "Offline data"}</div>
        </header>
        ${sectionMarkup}
      `;
    });
  }

  window.addEventListener("DOMContentLoaded", async () => {
    const state = await getOfflineGuideRuntimeState();
    if (state.shouldUseOfflineFallback && state.pwaInstalled) {
      renderOfflineDetail();
    }
  });
</script>

<style>
  .offline-empty-state {
    display: flex;
    justify-content: center;
    padding: 4rem 1rem;
  }

  .offline-empty-card {
    max-width: 680px;
    width: 100%;
    padding: 2rem;
    border-radius: 20px;
    border: 1px solid rgba(15, 23, 42, 0.1);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.08);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: #4f46e5;
  }

  .offline-empty-card h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.1;
  }

  .offline-empty-card p {
    margin: 0 0 1.25rem;
    color: rgba(15, 23, 42, 0.75);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem 1.1rem;
    border-radius: 999px;
    background: #0f172a;
    color: white;
    text-decoration: none;
    font-weight: 600;
  }
</style>
